# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay — KEY_ID is exposed to frontend (VITE_ prefix), KEY_SECRET stays server-side only
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your-key-secret

# Resend — server-side only, never expose to frontend
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Shiprocket — server-side only, never expose to frontend
# Get credentials from: https://app.shiprocket.in/settings/api
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL_PREFIX=your_public_url_prefix
