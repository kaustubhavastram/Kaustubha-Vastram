# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay — KEY_ID is exposed to frontend (VITE_ prefix), KEY_SECRET stays server-side only
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your-key-secret

# Resend — server-side only, never expose to frontend
RESEND_API_KEY=re_xxxxxxxxx

# EmailJS — Email notifications (frontend)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_TEMPLATE_CONTACT=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_WELCOME=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_ORDER=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_PRODUCT=template_xxxxxxx
